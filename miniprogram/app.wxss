/* F1 dark theme — mirrors the web app's palette. */
page {
  background: #15151e;
  color: #e8e8ec;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}
.f1-red { color: #e10600; }
.muted { color: #8a8a96; }
.mono { font-family: "SF Mono", Menlo, Consolas, monospace; }
.card {
  background: #1d1d28;
  border: 1rpx solid #2a2a38;
  border-radius: 12rpx;
}
.badge {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  border: 1rpx solid;
}
.badge-ok { color: #4ade80; border-color: rgba(74,222,128,0.4); }
.badge-podium { color: #facc15; border-color: rgba(250,204,21,0.4); }
.badge-rough { color: #fb923c; border-color: rgba(251,146,60,0.4); }
